{
	"version": 4,
	"configurePresets": [
		{
			"name": "gengaku-sdl3-wav-debug",
			"displayName": "Gengaku SDL3 WAV Debug",
			"description": "Local SDL3 debug build with audio dependencies kept to SDL3 output and built-in WAV decoding.",
			"inherits": "sdl3-debug",
			"binaryDir": "${sourceDir}/build/gengaku-sdl3-wav-debug",
			"cacheVariables": {
				"CMAKE_PREFIX_PATH": "${sourceDir}/__gi_deps",
				"PLAYER_BUILD_LIBLCF": "OFF",
				"liblcf_DIR": "${sourceDir}/__gi_deps/lib/cmake/liblcf",
				"INIH_INCLUDE_DIR": "${sourceDir}/liblcf/__gi_inih",
				"INIH_LIBRARY": "${sourceDir}/liblcf/__gi_inih/build-static/libinih.a",
				"PLAYER_ENABLE_TESTS": "OFF",
				"PLAYER_ENABLE_BENCHMARKS": "OFF",
				"PLAYER_TARGET_PLATFORM": "SDL3",
				"PLAYER_AUDIO_BACKEND": "SDL3",
				"PLAYER_ENABLE_DRWAV": "ON",
				"PLAYER_WITH_LIBSNDFILE": "OFF",
				"PLAYER_WITH_MPG123": "OFF",
				"PLAYER_WITH_OGGVORBIS": "OFF",
				"PLAYER_WITH_OPUS": "OFF",
				"PLAYER_WITH_WILDMIDI": "OFF",
				"PLAYER_WITH_FLUIDSYNTH": "OFF",
				"PLAYER_WITH_FLUIDLITE": "OFF",
				"PLAYER_WITH_XMP": "OFF",
				"PLAYER_AUDIO_RESAMPLER": "OFF",
				"PLAYER_WITH_LHASA": "OFF",
				"PLAYER_WITH_NLOHMANN_JSON": "OFF",
				"PLAYER_WITH_HARFBUZZ": "OFF",
				"PLAYER_WITH_BAEKMUK": "OFF",
				"PLAYER_WITH_WQY": "OFF"
			}
		}
	],
	"buildPresets": [
		{
			"name": "gengaku-sdl3-wav-debug",
			"displayName": "Build Gengaku SDL3 WAV Debug",
			"configurePreset": "gengaku-sdl3-wav-debug"
		}
	]
}
